---
import '../styles/global.css';
import pkg from '../../package.json';
import { SITE_NAME, SITE_TAGLINE, SITE_DOMAIN, CONTACT_EMAIL, NAV_LINKS } from '../config';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_TAGLINE,
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Home' ? SITE_NAME : `${title} — ${SITE_NAME}`;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, SITE_DOMAIN).href;
const ogImageURL = `${SITE_DOMAIN}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <!-- Fonts: preconnect in <head> so fonts load in parallel (avoids CLS vs CSS @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <!-- Replace /favicon.svg with your own -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__logo" aria-label=`${SITE_NAME} home`>
          {SITE_NAME}
        </a>

        <nav class="site-header__nav" aria-label="Main navigation">
          {NAV_LINKS.map(link => (
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Primary CTA — edit text and href, or ask Claude to remove it -->
        <a href="/contact" class="btn btn--primary site-header__cta">Get started</a>

        <button class="site-header__hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
        <div id="mobile-nav" class="mobile-nav" hidden>
          <nav aria-label="Mobile navigation">
            {NAV_LINKS.map(link => (
              <a href={link.href} class:list={[{ active: currentPath.startsWith(link.href) }]}>
                {link.label}
              </a>
            ))}
            <a href="/contact" class="btn btn--primary mobile-nav__cta">Get started</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <a href="/" class="site-footer__name">{SITE_NAME}</a>
          <p class="site-footer__tagline">{SITE_TAGLINE}</p>
        </div>
        <div class="site-footer__links">
          {NAV_LINKS.map(link => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
        <div class="site-footer__contact">
          <a href={`mailto:${CONTACT_EMAIL}`} class="site-footer__email">{CONTACT_EMAIL}</a>
        </div>
      </div>
      <div class="container site-footer__copy">
        <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
        <p class="site-footer__version">v{pkg.version}</p>
      </div>
    </footer>

    <script>
      // Mobile nav
      const hamburger = document.querySelector('.site-header__hamburger') as HTMLButtonElement;
      const mobileNav = document.getElementById('mobile-nav') as HTMLElement;

      function closeMobileNav() {
        mobileNav.hidden = true;
        hamburger.setAttribute('aria-expanded', 'false');
      }

      hamburger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !mobileNav.hidden;
        mobileNav.hidden = open;
        hamburger.setAttribute('aria-expanded', String(!open));
        if (!open) (mobileNav.querySelector('a') as HTMLElement)?.focus();
      });

      mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMobileNav));
      document.addEventListener('click', (e) => {
        if (!mobileNav.hidden && !hamburger.contains(e.target as Node) && !mobileNav.contains(e.target as Node)) {
          closeMobileNav();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { closeMobileNav(); hamburger.focus(); }
      });
    </script>
  </body>
</html>

<style>
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.skip-link {
  position: absolute; top: -100%; left: var(--space-md);
  padding: var(--space-xs) var(--space-md);
  background: var(--color-primary); color: #fff;
  border-radius: 0 0 4px 4px; font-weight: 600; text-decoration: none; z-index: 999;
}
.skip-link:focus { top: 0; }

.site-header {
  position: sticky; top: 0; z-index: 100;
  background: var(--color-bg); border-bottom: 1px solid var(--color-border);
}
.site-header__inner {
  display: flex; align-items: center; gap: var(--space-lg); padding-block: var(--space-md);
}
.site-header__logo {
  font-weight: 700; font-size: var(--text-lg); text-decoration: none;
  color: var(--color-ink); flex-shrink: 0;
}
.site-header__nav {
  display: flex; align-items: center; gap: var(--space-md); margin-right: auto;
}
.nav-link {
  text-decoration: none; color: var(--color-muted); font-size: var(--text-sm);
  font-weight: 500; white-space: nowrap; transition: color var(--transition);
  padding-bottom: 2px; border-bottom: 2px solid transparent;
}
.nav-link:hover { color: var(--color-ink); }
.nav-link.active { color: var(--color-ink); border-bottom-color: var(--color-primary); }
.site-header__cta { flex-shrink: 0; }

.site-header__hamburger {
  display: none; flex-direction: column; gap: 5px; background: none; border: none;
  cursor: pointer; padding: var(--space-xs); min-height: 44px; min-width: 44px;
  align-items: center; justify-content: center; margin-left: auto;
}
.site-header__hamburger span {
  display: block; width: 22px; height: 2px; background: var(--color-ink); border-radius: 2px;
}
.mobile-nav {
  position: absolute; top: calc(100% + 8px); right: var(--container-pad);
  background: var(--color-surface); border: 1px solid var(--color-border);
  border-radius: var(--border-radius); box-shadow: 0 4px 16px rgba(0,0,0,0.10);
  padding: var(--space-sm) var(--space-xs); min-width: 180px; z-index: 200;
}
.mobile-nav nav { display: flex; flex-direction: column; gap: 3px; }
.mobile-nav nav a {
  text-decoration: none; color: var(--color-ink); font-size: var(--text-base);
  padding: var(--space-xs) var(--space-sm); border-radius: calc(var(--border-radius) - 1px);
  transition: background var(--transition); display: block;
}
.mobile-nav nav a:hover { background: var(--color-surface-alt); }
.mobile-nav nav a.active { color: var(--color-primary); font-weight: 600; }
.mobile-nav__cta { display: none; align-self: flex-start; margin-top: var(--space-xs); }

.site-footer {
  background: var(--color-charcoal); color: var(--color-bg);
  padding-top: var(--space-3xl); padding-bottom: var(--space-xl);
}
.site-footer__inner {
  display: flex; flex-wrap: wrap; gap: var(--space-2xl); padding-bottom: var(--space-xl);
  border-bottom: 1px solid rgba(255,255,255,0.12); align-items: start;
}
.site-footer__brand { display: flex; flex-direction: column; gap: var(--space-xs); }
.site-footer__name { color: #fff; font-weight: 700; font-size: var(--text-lg); text-decoration: none; }
.site-footer__tagline { color: rgba(255,255,255,0.6); font-size: var(--text-sm); }
.site-footer__links { display: flex; flex-direction: column; gap: var(--space-xs); }
.site-footer__links a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: var(--text-sm); }
.site-footer__links a:hover { color: #fff; }
.site-footer__contact { margin-left: auto; }
.site-footer__email { color: rgba(255,255,255,0.65); font-size: var(--text-sm); text-decoration: none; }
.site-footer__email:hover { color: #fff; }
.site-footer__copy {
  padding-top: var(--space-lg); color: rgba(255,255,255,0.35); font-size: var(--text-sm);
  display: flex; justify-content: space-between; align-items: baseline;
}
.site-footer__copy p { max-width: none; margin-bottom: 0; }
.site-footer__version { font-size: var(--text-xs); color: rgba(255,255,255,0.2); }

@media (max-width: 768px) {
  .site-header__nav { display: none; }
  .site-header__cta { display: none; }
  .site-header__hamburger { display: flex; }
  .mobile-nav__cta { display: inline-flex; }
}
</style>
